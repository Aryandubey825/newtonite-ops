{
  "name": "operations-under-pressure",
  "version": "1.0.0",
  "private": true,
  "description": "Newtonite Operations Under Pressure - High-Integrity Operational Work Item Platform",
  "scripts": {
    "server:install": "cd server && npm install",
    "client:install": "cd client && npm install",
    "install:all": "npm run server:install && npm run client:install",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npx tsx prisma/seed.ts",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "test": "cd server && npm test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "concurrency",
    "optimistic-locking",
    "idempotency",
    "rbac",
    "workflow",
    "transactional-outbox",
    "newtonite"
  ],
  "author": "Newtonite Candidate",
  "license": "ISC"
}
